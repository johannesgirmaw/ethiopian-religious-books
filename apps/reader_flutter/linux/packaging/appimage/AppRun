#!/usr/bin/env bash
# AppImage entrypoint — resolves the mounted AppDir and launches the Flutter runner.
set -euo pipefail

HERE="$(dirname "$(readlink -f "${0}")")"

# Flutter's Linux runner resolves data/ and lib/ relative to the executable's
# directory, so run from the bundle root.
export LD_LIBRARY_PATH="${HERE}/usr/lib/felege-metsahft/lib:${LD_LIBRARY_PATH:-}"
export XDG_DATA_DIRS="${HERE}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

cd "${HERE}/usr/lib/felege-metsahft"
exec ./ethiopian_reader "$@"
