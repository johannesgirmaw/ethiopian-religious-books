# Copy to infra/.env and adjust. Used by docker compose.

# --- PostgreSQL ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=religious_books
# Host port (container stays 5432). Default 15432 avoids clashing with a local Postgres on 5432.
POSTGRES_PORT=15432

# --- Redis ---
# Host port (container stays 6379). Default 16379 avoids clashing with a local Redis on 6379.
REDIS_PORT=16379

# --- MinIO (S3-compatible local) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_secret_change_me
# Host ports (API 9000, console 9001 inside container). Defaults 19000/19001 avoid common host clashes.
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
# Presigned S3 URLs default to http://localhost:${MINIO_API_PORT} in docker-compose.
# For a physical device or Android emulator, set e.g. AWS_S3_PRESIGN_ENDPOINT_URL=http://192.168.x.x:19000

# --- Mailhog ---
# Host ports (1025/8025 inside container). Defaults 11025/18025 avoid common host clashes.
MAILHOG_SMTP_PORT=11025
MAILHOG_UI_PORT=18025

# --- Django API ---
# Published on the host as http://localhost:API_PORT (maps to container port 8000).
# Default 8000 matches Django’s usual dev port. Override if the port is busy.
API_PORT=8000
DJANGO_SECRET_KEY=dev-insecure-change-me
AWS_STORAGE_BUCKET_NAME=religious-books-dev

# --- Django (when running on HOST, not in Docker yet) ---
# DATABASE_URL=postgresql://app:app@localhost:15432/religious_books
# REDIS_URL=redis://localhost:16379/0
# AWS_S3_ENDPOINT_URL=http://localhost:19000
# AWS_ACCESS_KEY_ID=minio
# AWS_SECRET_ACCESS_KEY=minio_secret_change_me
# AWS_STORAGE_BUCKET_NAME=religious-books-dev
# Presigned URLs (use host/LAN IP reachable by the app, not the Docker service name):
# AWS_S3_PRESIGN_ENDPOINT_URL=http://localhost:19000
# EMAIL_HOST=localhost
# EMAIL_PORT=11025
